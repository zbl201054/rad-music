{
  "id": "netease.source",
  "name": "网易云音乐",
  "type": "source",
  "platforms": ["netease"],
  "api_version": "1",
  "version": "1.3.1-java",
  "version_range": ">=1.0.0",
  "transport": "http",
  "endpoint": "http://127.0.0.1:8848",
  "capabilities": [
    "search",
    "get_song",
    "get_url",
    "get_qualities",
    "get_lyric",
    "get_pic",
    "get_playlist",
    "get_album",
    "search_playlist",
    "search_album",
    "search_artist",
    "get_artist",
    "search_mv",
    "get_mv",
    "settings",
    "check_login",
    "login_cookie",
    "logout"
  ],
  "permissions": ["network", "account"],
  "limits": { "max_concurrency": 4, "qps": 5 },
  "quality_levels": [
    { "id": "standard", "label": "标准", "level": "low", "codec": "mp3", "lossless": false, "bitrate": 128, "sample_rate": 44100, "channels": 2 }
  ]
}
