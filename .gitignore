# ---------------------------------------------------------------- 用户曲库数据
# 曲库目录（tracks / cache / covers / index / library / mv / logs / presets / settings.json）
# 体积极大且含个人音乐资源，绝不入库
api/radmusic-data/
radmusic-data/

# ---------------------------------------------------------------- 凭据与隐私
**/cookie.txt
**/*cookie*.txt
**/*cookie*.json
**/usec.json
**/usec/**
.env
.env.*
*.pem

# ---------------------------------------------------------------- 日志
*.log
**/*.log

# ---------------------------------------------------------------- 构建产物
api/build/
build/
build-*/
*.o
*.obj
*.exe
*.dll
*.lib
*.pdb
*.ilk

# ---------------------------------------------------------------- 运行时暂存/中间态
**/cache/tmp/
**/.staging/
*.tmp
*.bak

# ---------------------------------------------------------------- 发布产物与归档（只发布到 GitHub Releases，不入库）
dist/
*.zip

# ---------------------------------------------------------------- 开发辅助与工具目录（不入库）
.workbuddy/

# ---------------------------------------------------------------- 插件自检 / 临时产物（不入库）
plugins/recommend/selftest_out.txt

# ---------------------------------------------------------------- 编辑器与系统
.vscode/
.idea/
Thumbs.db
Desktop.ini
.DS_Store
__pycache__/
*.pyc

# ---------------------------------------------------------------- 两端打包产物
# 桌面端 dist/ 与安卓端中间产物都是可重新生成的，不入库
dist/
android/build/
android/assets/web/
android/assets/web_version.txt
android/jniLibs/
android/keystore/
*.apk

# desktop/ 是源码目录，但就地编译会在里面留下 .o/.d/.res/可执行文件与运行时目录
desktop/*.o
desktop/*.d
desktop/*.res
desktop/*.bak*
desktop/radmusic-data/
desktop/web/
desktop/plugins/
desktop/tmp_*/
desktop/updates/
desktop/migtest_*/
desktop/data_root.txt
desktop/debug.log

# 本机启动脚本（写死了本机的绝对路径，只适合本机）
start_radmusic.bat
